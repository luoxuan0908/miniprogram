/* pages/review/review.wxss */
.me-page {
  min-height: 100vh;
  background: #ffffff;
  padding: 32rpx 28rpx 150rpx;
  box-sizing: border-box;
}

/* 用户信息卡片 */
.user-profile-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding-bottom: 40rpx;
  margin-bottom: 40rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.profile-avatar-wrap {
  flex-shrink: 0;
}

.avatar-btn {
  display: block;
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  margin: 0;
  background: none;
  border: none;
  border-radius: 50%;
  overflow: hidden;
  line-height: 0;
}

.avatar-btn::after {
  border: none;
}

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #eef0f3;
}

.default-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 850;
  color: #9aa0aa;
  background-color: #eef0f3;
}

.profile-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 850;
  color: #111217;
  line-height: 1.3;
  min-height: 44rpx;
  padding: 0;
}

.profile-id {
  font-size: 24rpx;
  color: #9aa0aa;
  line-height: 1.3;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-bottom: 54rpx;
}

.stat-card {
  min-height: 174rpx;
  border: 1rpx solid #dfe3e8;
  border-radius: 10rpx;
  padding: 30rpx 34rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.stat-icon {
  font-size: 40rpx;
  line-height: 1;
  margin-bottom: 18rpx;
  font-weight: 800;
}

.black { color: #000000; }
.green { color: #13a14a; }
.amber { color: #cc8500; }
.red { color: #e1242f; }
.blue { color: #2f6eea; }

.stat-label {
  color: #6f7582;
  font-size: 25rpx;
  line-height: 1.3;
}

.stat-value {
  margin-top: 8rpx;
  color: #000000;
  font-size: 46rpx;
  line-height: 1.05;
  font-weight: 850;
}

.duration-value {
  font-size: 34rpx;
  line-height: 1.18;
  word-break: keep-all;
}

.billing-panel {
  min-height: 136rpx;
  border-radius: 12rpx;
  background: #111217;
  color: #ffffff;
  padding: 28rpx;
  margin-bottom: 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.billing-label,
.billing-side-label {
  color: rgba(255, 255, 255, 0.66);
  font-size: 23rpx;
  line-height: 1.3;
}

.billing-value {
  margin-top: 10rpx;
  font-size: 42rpx;
  line-height: 1.05;
  font-weight: 850;
}

.billing-side {
  text-align: right;
  flex-shrink: 0;
}

.billing-side-value {
  margin-top: 10rpx;
  font-size: 28rpx;
  line-height: 1.2;
  font-weight: 800;
}

.billing-side-sub {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 22rpx;
  line-height: 1.3;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #000000;
  font-size: 30rpx;
  font-weight: 850;
  margin-bottom: 26rpx;
}

.section-icon {
  color: #6f7582;
  font-size: 32rpx;
}

.settings-list {
  margin-top: 26rpx;
  border: 1rpx solid #dfe3e8;
  border-radius: 10rpx;
  overflow: hidden;
}

.settings-row {
  min-height: 88rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #111217;
  font-size: 27rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.settings-row:last-child {
  border-bottom: none;
}

.settings-arrow,
.settings-meta {
  color: #9aa0aa;
}
