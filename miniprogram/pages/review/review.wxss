/* pages/review/review.wxss */
.me-page {
  min-height: 100vh;
  background: #ffffff;
  padding: 32rpx 28rpx 150rpx;
  box-sizing: border-box;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-bottom: 54rpx;
}

.stat-card {
  min-height: 174rpx;
  border: 1rpx solid #dfe3e8;
  border-radius: 10rpx;
  padding: 30rpx 34rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.stat-icon {
  font-size: 40rpx;
  line-height: 1;
  margin-bottom: 18rpx;
  font-weight: 800;
}

.black { color: #000000; }
.green { color: #13a14a; }
.amber { color: #cc8500; }
.red { color: #e1242f; }
.blue { color: #2f6eea; }

.stat-label {
  color: #6f7582;
  font-size: 25rpx;
  line-height: 1.3;
}

.stat-value {
  margin-top: 8rpx;
  color: #000000;
  font-size: 46rpx;
  line-height: 1.05;
  font-weight: 850;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #000000;
  font-size: 30rpx;
  font-weight: 850;
  margin-bottom: 26rpx;
}

.section-icon {
  color: #6f7582;
  font-size: 32rpx;
}

.prefs-panel {
  border: 1rpx solid #dfe3e8;
  border-radius: 10rpx;
  padding: 34rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.pref-label {
  color: #6f7582;
  font-size: 26rpx;
  margin-bottom: 22rpx;
}

.speed-value {
  color: #9aa0aa;
  font-size: 24rpx;
  margin-top: 4rpx;
}

.voice-label {
  margin-top: 34rpx;
}

.picker-row {
  height: 72rpx;
  border: 1rpx solid #dfe3e8;
  border-radius: 8rpx;
  padding: 0 18rpx;
  color: #000000;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.settings-list {
  margin-top: 26rpx;
  border: 1rpx solid #dfe3e8;
  border-radius: 10rpx;
  overflow: hidden;
}

.settings-row {
  min-height: 88rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #111217;
  font-size: 27rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.settings-row:last-child {
  border-bottom: none;
}

.settings-arrow,
.settings-meta {
  color: #9aa0aa;
}
