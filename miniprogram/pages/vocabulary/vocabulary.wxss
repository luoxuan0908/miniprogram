/* pages/vocabulary/vocabulary.wxss */
.vocab-page {
  min-height: 100vh;
  background: #ffffff;
  padding: 32rpx 32rpx 120rpx;
  box-sizing: border-box;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.page-title {
  font-size: 42rpx;
  color: #111217;
  font-weight: 800;
}

.page-subtitle {
  margin-top: 6rpx;
  color: #8b8f99;
  font-size: 24rpx;
}

.top-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.icon-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  border: 1rpx solid #e4e6eb;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #111217;
  font-size: 32rpx;
}

.primary-btn {
  background: #111217;
  color: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx 28rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.search-row {
  height: 86rpx;
  border: 1rpx solid #e3e5ea;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  padding: 0 22rpx;
  margin-bottom: 20rpx;
}

.search-icon {
  color: #8b8f99;
  font-size: 30rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  height: 86rpx;
  font-size: 30rpx;
  color: #111217;
}

.search-placeholder {
  color: #9da1aa;
}

.clear-btn {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: #f0f1f4;
  color: #727780;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.filter-row {
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
  margin-bottom: 24rpx;
}

.filter {
  flex-shrink: 0;
  padding: 14rpx 22rpx;
  border-radius: 12rpx;
  border: 1rpx solid #e3e5ea;
  color: #727780;
  font-size: 23rpx;
  font-weight: 700;
}

.filter.active {
  background: #111217;
  border-color: #111217;
  color: #ffffff;
}

.practice-banner {
  border: 1rpx solid #e7e8ec;
  border-radius: 14rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.banner-title {
  font-size: 30rpx;
  color: #111217;
  font-weight: 800;
}

.banner-subtitle {
  color: #8b8f99;
  font-size: 23rpx;
  margin-top: 6rpx;
}

.banner-play {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #2e6be6;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.word-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.word-card {
  border: 1rpx solid #e7e8ec;
  border-radius: 14rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.word-main {
  flex: 1;
  min-width: 0;
}

.word-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.word-name {
  font-size: 34rpx;
  font-weight: 800;
  color: #111217;
}

.status-badge {
  flex-shrink: 0;
  font-size: 21rpx;
  font-weight: 700;
  padding: 5rpx 12rpx;
  border-radius: 8rpx;
}

.badge-new {
  background: #eaf3ff;
  color: #2675d9;
}

.badge-learning {
  background: #fff4d8;
  color: #a96a00;
}

.badge-mastered {
  background: #eaf8ef;
  color: #168246;
}

.word-hint,
.word-def {
  margin-top: 8rpx;
  color: #727780;
  font-size: 25rpx;
  line-height: 1.45;
}

.word-action {
  width: 58rpx;
  height: 58rpx;
  border-radius: 12rpx;
  background: #f4f5f7;
  color: #111217;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
}

.empty-state {
  padding: 120rpx 24rpx;
  text-align: center;
}

.empty-title {
  color: #111217;
  font-size: 34rpx;
  font-weight: 800;
}

.empty-desc {
  margin: 14rpx auto 28rpx;
  max-width: 480rpx;
  color: #8b8f99;
  font-size: 25rpx;
  line-height: 1.55;
}

.empty-action {
  display: inline-flex;
}
