/* pages/add-word/add-word.wxss */
.input-section {
  padding: 40rpx 0;
}

.section-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.word-input {
  width: 100%;
  height: 88rpx;
  font-size: 36rpx;
  border: none;
  outline: none;
}

.input-wrapper {
  background: #fff;
  border-radius: 16rpx;
  border: 2rpx solid #e8e8e8;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.input-wrapper:focus-within {
  border-color: #111217;
}

.error-msg {
  color: #ff4d4f;
  font-size: 26rpx;
  text-align: center;
  margin-top: 16rpx;
}

/* 生成结果 */
.result-section {
  margin-top: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #111217;
}

.difficulty-badge {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.star {
  font-size: 24rpx;
  color: #e0e0e0;
}

.star.active {
  color: #faad14;
}

.diff-text {
  font-size: 22rpx;
  color: #999;
  margin-left: 8rpx;
}

/* 预览卡片 */
.preview-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.preview-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #999;
  margin-bottom: 12rpx;
}

.preview-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.preview-text.definition {
  font-style: italic;
  color: #555;
}

.preview-text.cloze {
  color: #111217;
  font-weight: 500;
}

/* 操作按钮 */
.action-section {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-bottom: 40rpx;
}
