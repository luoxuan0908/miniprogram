/* pages/listen/listen.wxss */
.practice-page {
  min-height: 100vh;
  background: #ffffff;
  padding: 70rpx 28rpx 150rpx;
  box-sizing: border-box;
}

.page-title {
  color: #000000;
  font-size: 48rpx;
  line-height: 1.15;
  font-weight: 850;
}

.page-subtitle {
  margin-top: 18rpx;
  color: #6f7582;
  font-size: 30rpx;
  line-height: 1.35;
  margin-bottom: 42rpx;
}

.mode-card {
  min-height: 176rpx;
  border: 1rpx solid #dfe3e8;
  border-radius: 12rpx;
  padding: 32rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 34rpx;
  margin-bottom: 28rpx;
  background: #ffffff;
}

.mode-card:active {
  background: #f8f9fb;
}

.mode-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 10rpx;
  background: #f2f3f6;
  color: #344054;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  flex-shrink: 0;
}

.mode-copy {
  flex: 1;
  min-width: 0;
}

.mode-title {
  color: #000000;
  font-size: 32rpx;
  font-weight: 850;
  line-height: 1.25;
}

.mode-desc {
  margin-top: 12rpx;
  color: #6f7582;
  font-size: 28rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
