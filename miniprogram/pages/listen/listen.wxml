<!--pages/listen/listen.wxml-->
<view class="practice-page">
  <view class="page-title">练习中心</view>
  <view class="page-subtitle">选择学习模式</view>

  <view class="mode-card" bindtap="onDocumentPractice">
    <view class="mode-icon">▤</view>
    <view class="mode-copy">
      <view class="mode-title">文档跟读</view>
      <view class="mode-desc">{{documentDesc}}</view>
    </view>
  </view>

  <view class="mode-card" bindtap="onVocabularyPractice">
    <view class="mode-icon">◉</view>
    <view class="mode-copy">
      <view class="mode-title">生词复习</view>
      <view class="mode-desc">今日 {{dueCount}} 个待复习</view>
    </view>
  </view>
</view>
