/* pages/index/index.wxss */
.home-page {
  min-height: 100vh;
  background: #ffffff;
  padding: 54rpx 28rpx 150rpx;
  box-sizing: border-box;
}

.greeting {
  margin-bottom: 34rpx;
}

.greeting-title {
  color: #000000;
  font-size: 48rpx;
  line-height: 1.15;
  font-weight: 850;
}

.greeting-subtitle {
  margin-top: 18rpx;
  color: #6f7582;
  font-size: 31rpx;
  line-height: 1.35;
}

.module-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.module-card {
  min-height: 190rpx;
  border: 1rpx solid #dfe3e8;
  border-radius: 12rpx;
  padding: 34rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.module-card:active {
  background: #f8f9fb;
}

.module-disabled {
  opacity: 0.55;
}

.module-icon {
  color: #000000;
  font-size: 42rpx;
  line-height: 1;
  margin-bottom: 24rpx;
}

.module-title {
  color: #000000;
  font-size: 31rpx;
  line-height: 1.25;
  font-weight: 820;
}

.module-desc {
  margin-top: 10rpx;
  color: #707784;
  font-size: 26rpx;
  line-height: 1.35;
}

.section-head {
  margin: 48rpx 0 24rpx;
  color: #6f7582;
  font-size: 30rpx;
  font-weight: 800;
}

.recent-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.recent-row,
.recent-empty {
  min-height: 118rpx;
  border: 1rpx solid #cfd4db;
  border-radius: 10rpx;
  padding: 22rpx 26rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.recent-row {
  justify-content: space-between;
  gap: 18rpx;
}

.recent-copy {
  flex: 1;
  min-width: 0;
}

.recent-title {
  color: #000000;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-meta {
  margin-top: 8rpx;
  color: #707784;
  font-size: 25rpx;
}

.recent-arrow {
  color: #9aa0aa;
  font-size: 34rpx;
}

.recent-empty {
  color: #707784;
  font-size: 26rpx;
  line-height: 1.45;
}
