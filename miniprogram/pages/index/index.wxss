/* pages/index/index.wxss */
.home-page {
  min-height: 100vh;
  background: #ffffff;
  padding: 54rpx 28rpx 150rpx;
  box-sizing: border-box;
}

.module-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.module-card {
  min-height: 190rpx;
  border: 1rpx solid #dfe3e8;
  border-radius: 12rpx;
  padding: 34rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.module-card:active {
  background: #f8f9fb;
}

.module-disabled {
  opacity: 0.55;
}

.module-icon {
  color: #000000;
  font-size: 42rpx;
  line-height: 1;
  margin-bottom: 24rpx;
}

.module-title {
  color: #000000;
  font-size: 31rpx;
  line-height: 1.25;
  font-weight: 820;
}

.module-desc {
  margin-top: 10rpx;
  color: #707784;
  font-size: 26rpx;
  line-height: 1.35;
}

.daily-card {
  margin-top: 28rpx;
  min-height: 132rpx;
  border-radius: 12rpx;
  background: #111217;
  color: #ffffff;
  padding: 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.daily-title {
  font-size: 32rpx;
  font-weight: 850;
}

.daily-meta {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 25rpx;
}

.daily-duration {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.58);
  font-size: 23rpx;
}

.daily-progress {
  font-size: 38rpx;
  font-weight: 850;
}

.billing-card {
  margin-top: 18rpx;
  min-height: 108rpx;
  border: 1rpx solid #dfe3e8;
  border-radius: 10rpx;
  padding: 24rpx 26rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.billing-card:active {
  background: #f8f9fb;
}

.billing-title {
  color: #111217;
  font-size: 29rpx;
  font-weight: 820;
  line-height: 1.3;
}

.billing-meta {
  margin-top: 8rpx;
  color: #707784;
  font-size: 24rpx;
  line-height: 1.3;
}

.billing-balance {
  color: #111217;
  font-size: 34rpx;
  font-weight: 850;
  line-height: 1.1;
  flex-shrink: 0;
}

.section-head {
  margin: 48rpx 0 24rpx;
  color: #6f7582;
  font-size: 30rpx;
  font-weight: 800;
}

.recent-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.recent-row,
.recent-empty {
  min-height: 118rpx;
  border: 1rpx solid #cfd4db;
  border-radius: 10rpx;
  padding: 22rpx 26rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.recent-row {
  justify-content: space-between;
  gap: 18rpx;
}

.recent-copy {
  flex: 1;
  min-width: 0;
}

.recent-title {
  color: #000000;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-meta {
  margin-top: 8rpx;
  color: #707784;
  font-size: 25rpx;
}

.recent-arrow {
  color: #9aa0aa;
  font-size: 34rpx;
}

.recent-empty {
  color: #707784;
  font-size: 26rpx;
  line-height: 1.45;
}

/* 临时：数据导入管理按钮 */
.import-admin-btn {
  position: fixed;
  right: 28rpx;
  bottom: 200rpx;
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 50%;
  background: #111217;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.2);
}
