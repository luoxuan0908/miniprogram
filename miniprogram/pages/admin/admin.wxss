.container {
  padding: 32rpx;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.info {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 24rpx;
}

.progress-info {
  display: flex;
  flex-direction: column;
  font-size: 26rpx;
  color: #333;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.btn {
  margin-bottom: 16rpx;
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.btn[disabled] {
  opacity: 0.5;
}

.btn-secondary {
  background: #ff9800;
}

.btn-warning {
  background: #e74c3c;
}

.btn-ghost {
  background: transparent;
  color: #999;
  border: 1rpx solid #ddd;
  font-size: 26rpx;
}

.btn-group {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.btn-group .btn {
  flex: 1;
  margin-bottom: 0;
}

.log-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
}

.log-list {
  max-height: 600rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 16rpx;
}

.log-item {
  font-size: 22rpx;
  font-family: monospace;
  line-height: 1.5;
  color: #333;
}

.log-item.error {
  color: #e74c3c;
}

.log-item.success {
  color: #07c160;
}

.log-time {
  color: #aaa;
  margin-right: 8rpx;
}
