/* pages/resource-detail/resource-detail.wxss */
.reader-page {
  min-height: 100vh;
  background: #ffffff;
  padding: 20rpx 18rpx 40rpx;
  box-sizing: border-box;
}

.reader-page.player-open {
  padding-bottom: 340rpx;
}

.reader-shell {
  border: 1rpx solid #dfe3e8;
  border-radius: 10rpx;
  min-height: calc(100vh - 110rpx);
  overflow: hidden;
}

.reader-page.player-open .reader-shell {
  min-height: calc(100vh - 370rpx);
}

.reader-top {
  height: 82rpx;
  display: grid;
  grid-template-columns: 72rpx 1fr 72rpx;
  align-items: center;
  border-bottom: 1rpx solid #eef0f3;
}

.tool-btn {
  color: #000000;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.doc-title {
  color: #6f7582;
  font-size: 25rpx;
  font-weight: 700;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.segment-scroll {
  max-height: calc(100vh - 200rpx);
  min-height: 640rpx;
}

.reader-page.player-open .segment-scroll {
  max-height: calc(100vh - 460rpx);
}

.segment {
  padding: 26rpx 22rpx;
}

.segment.active {
  background: #fff9bd;
}

.segment-tools {
  height: 44rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  color: #a4a9b1;
  font-size: 22rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.mini-play {
  font-size: 25rpx;
}

.translate-btn {
  font-size: 21rpx;
}

.audio-status {
  color: #7c818c;
  font-size: 20rpx;
  font-weight: 500;
}

.segment-text {
  color: #364152;
  font-size: 34rpx;
  line-height: 1.85;
  font-weight: 450;
}

.translation {
  margin-top: 18rpx;
  color: #39465a;
  font-size: 29rpx;
  line-height: 1.75;
  font-weight: 600;
}

.translating-hint {
  color: #9ca3af;
  font-size: 26rpx;
  font-weight: 400;
}

.player-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  min-height: 300rpx;
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #e6e8ed;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  z-index: 10;
}

.time-label {
  text-align: right;
  color: #6f7582;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.wave-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.play-circle {
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  background: #2f6eea;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 6rpx 14rpx rgba(47, 110, 234, 0.26);
}

.wave-track {
  position: relative;
  flex: 1;
  height: 70rpx;
  display: flex;
  align-items: center;
}

.wave-bars {
  display: flex;
  align-items: center;
  gap: 7rpx;
  width: 100%;
}

.bar {
  flex: 1;
  border-radius: 20rpx;
  background: #d8dadd;
}

.bar-0 { height: 18rpx; }
.bar-1 { height: 34rpx; }
.bar-2 { height: 24rpx; }
.bar-3 { height: 44rpx; }
.bar-4 { height: 28rpx; }

.progress-line {
  position: absolute;
  left: 0;
  top: 50%;
  height: 6rpx;
  border-radius: 10rpx;
  background: #3aa0eb;
  transform: translateY(-50%);
}

.player-actions {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 24rpx;
  margin-top: 34rpx;
}

.square-btn {
  width: 70rpx;
  height: 70rpx;
  border-radius: 10rpx;
  border: 1rpx solid #e0e3e8;
  background: #ffffff;
  color: #111217;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(17, 18, 23, 0.06);
}

.empty-state {
  min-height: 80vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
  text-align: center;
}

.empty-title {
  color: #111217;
  font-size: 36rpx;
  font-weight: 850;
}

.empty-desc {
  margin-top: 12rpx;
  color: #777d88;
  font-size: 26rpx;
}
