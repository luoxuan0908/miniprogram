/* 全局样式变量 */
page {
  --primary: #111217;
  --primary-dark: #000000;
  --primary-light: #3b3d45;
  --bg-dark: #111217;
  --bg-card: #ffffff;
  --bg-page: #ffffff;
  --text-primary: #111217;
  --text-secondary: #6f7582;
  --text-hint: #9aa0aa;
  --border: #dfe3e8;
  --success: #52c41a;
  --warning: #faad14;
  --danger: #ff4d4f;

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  color: var(--text-primary);
  background-color: var(--bg-page);
  box-sizing: border-box;
}

/* 通用布局 */
.container {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.flex-1 {
  flex: 1;
}

/* 卡片 */
.card {
  background: var(--bg-card);
  border-radius: 10rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.card-hover {
  transition: transform 0.15s;
}

.card-hover:active {
  transform: scale(0.98);
}

/* 按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  padding: 20rpx 40rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  transition: opacity 0.2s;
}

.btn:active {
  opacity: 0.8;
}

.btn-primary {
  background: var(--primary);
  color: #fff;
}

.btn-success {
  background: var(--success);
  color: #fff;
}

.btn-danger {
  background: var(--danger);
  color: #fff;
}

.btn-outline {
  background: transparent;
  border: 2rpx solid var(--border);
  color: var(--text-secondary);
}

.btn-block {
  width: 100%;
}

.btn-sm {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
}

.btn-lg {
  padding: 24rpx 48rpx;
  font-size: 32rpx;
}

.btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* FAB 浮动按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(233, 69, 96, 0.4);
  z-index: 100;
}

.fab:active {
  transform: scale(0.95);
}

/* 状态标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

.tag-new {
  background: #e6f7ff;
  color: #1890ff;
}

.tag-learning {
  background: #fff7e6;
  color: #fa8c16;
}

.tag-mastered {
  background: #f6ffed;
  color: #52c41a;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: var(--border);
  margin: 20rpx 0;
}

/* 文字截断 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.empty-state .icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.3;
}

.empty-state .text {
  font-size: 28rpx;
  color: var(--text-hint);
  text-align: center;
  margin-bottom: 40rpx;
}

/* 加载 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx;
}

.loading-text {
  margin-top: 20rpx;
  color: var(--text-hint);
  font-size: 26rpx;
}

/* 输入框 */
.input-wrapper {
  background: var(--bg-card);
  border-radius: 12rpx;
  border: 2rpx solid var(--border);
  padding: 0 24rpx;
  display: flex;
  align-items: center;
}

.input-wrapper:focus-within {
  border-color: var(--primary);
}

.input-wrapper input {
  flex: 1;
  height: 80rpx;
  font-size: 30rpx;
  border: none;
  outline: none;
}

/* 统计面板 */
.stats-grid {
  display: flex;
  gap: 16rpx;
}

.stat-card {
  flex: 1;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.stat-card .stat-number {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--primary);
}

.stat-card .stat-label {
  font-size: 22rpx;
  color: var(--text-hint);
  margin-top: 8rpx;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: 12rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.search-bar .search-icon {
  font-size: 32rpx;
  color: var(--text-hint);
  margin-right: 12rpx;
}

.search-bar input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  border: none;
  outline: none;
}

/* Tab 筛选栏 */
.filter-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.filter-tab {
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  background: var(--bg-card);
  border: 2rpx solid var(--border);
  flex-shrink: 0;
}

.filter-tab.active {
  background: var(--primary);
  color: #fff;
  border-color: var(--primary);
}

/* 页面头部 */
.page-header {
  padding: 24rpx 24rpx 0;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--text-hint);
}

/* 可折叠区域 */
.collapse-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
}

.collapse-header .arrow {
  transition: transform 0.3s;
  font-size: 24rpx;
  color: var(--text-hint);
}

.collapse-header .arrow.expanded {
  transform: rotate(180deg);
}

/* 音频播放按钮 */
.audio-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #fff;
}

.audio-btn.playing {
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

/* 遮罩 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
}

/* 安全区 */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
