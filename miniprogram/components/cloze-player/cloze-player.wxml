<!--components/cloze-player/cloze-player.wxml-->
<view class="cloze-player {{phase}}">
  <!-- 播放挖空句阶段 -->
  <view class="player-stage" wx:if="{{phase === 'playing' || phase === 'guessing'}}">
    <view class="play-area" bindtap="onPlayCloze">
      <view class="play-btn {{isPlaying ? 'playing' : ''}}">
        <text class="play-icon">{{isPlaying ? '⏸' : '▶'}}</text>
      </view>
      <view class="play-label">{{isPlaying ? '播放中...' : '点击听挖空句'}}</view>
    </view>

    <view class="cloze-text" wx:if="{{showClozeText}}">
      <text class="cloze-before">{{clozeBefore}}</text>
      <text class="cloze-blank">______</text>
      <text class="cloze-after">{{clozeAfter}}</text>
    </view>

    <view class="hint-toggle" wx:if="{{chineseHint && !showChineseHint}}" bindtap="onToggleHint">
      查看提示
    </view>
    <view class="chinese-hint" wx:if="{{showChineseHint}}">
      💡 {{chineseHint}}
    </view>

    <view class="guess-input" wx:if="{{phase === 'guessing' || userInput}}">
      <input
        class="guess-field"
        placeholder="输入你听到的单词..."
        value="{{userInput}}"
        bindinput="onInput"
        confirm-type="done"
        bindconfirm="onReveal"
      />
    </view>

    <view class="action-btns" wx:if="{{!isPlaying || phase === 'guessing'}}">
      <view class="btn btn-outline btn-sm" wx:if="{{!userInput && phase !== 'guessing'}}" bindtap="onStartGuessing">
        开始输入
      </view>
      <view class="btn btn-primary btn-sm" bindtap="onReveal" wx:if="{{userInput || phase === 'guessing'}}">
        揭晓答案
      </view>
    </view>
  </view>

  <!-- 揭晓答案阶段 -->
  <view class="reveal-stage" wx:if="{{phase === 'revealed'}}">
    <view class="answer-word {{isCorrect ? 'correct' : 'incorrect'}}">
      {{word}}
    </view>
    <view class="your-guess" wx:if="{{userInput}}">
      你的答案：<text class="{{isCorrect ? 'text-success' : 'text-danger'}}">{{userInput}}</text>
    </view>

    <view class="play-full-btn" bindtap="onPlayFull">
      <view class="audio-btn {{isPlayingFull ? 'playing' : ''}}">
        <text>🔊</text>
      </view>
      <text class="play-full-label">播放完整例句</text>
    </view>

    <view class="full-example" wx:if="{{fullExample}}">
      {{fullExample}}
    </view>

    <view class="result-btns">
      <view class="btn btn-success" bindtap="onCorrect">
        ✓ 我答对了
      </view>
      <view class="btn btn-danger" bindtap="onIncorrect">
        ✗ 我答错了
      </view>
    </view>
  </view>
</view>
