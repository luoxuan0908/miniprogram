/* components/cloze-player/cloze-player.wxss */
.cloze-player {
  padding: 40rpx 24rpx;
}

/* 播放区域 */
.play-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
}

.play-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #111217;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(17, 18, 23, 0.16);
}

.play-btn.playing {
  animation: pulse 1.5s infinite;
  background: #2f6eea;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); box-shadow: 0 8rpx 24rpx rgba(17, 18, 23, 0.16); }
  50% { transform: scale(1.05); box-shadow: 0 12rpx 32rpx rgba(47, 110, 234, 0.28); }
}

.play-icon {
  font-size: 40rpx;
  color: #fff;
}

.play-label {
  font-size: 26rpx;
  color: #999;
}

/* 挖空文本 */
.cloze-text {
  text-align: center;
  font-size: 32rpx;
  line-height: 1.8;
  padding: 30rpx 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  margin: 20rpx 0;
  color: #666;
}

.cloze-blank {
  color: #111217;
  font-weight: 700;
  border-bottom: 3rpx dashed #111217;
  padding: 0 12rpx;
}

/* 中文提示 */
.hint-toggle {
  text-align: center;
  font-size: 24rpx;
  color: #1890ff;
  padding: 16rpx 0;
}

.chinese-hint {
  text-align: center;
  font-size: 28rpx;
  color: #fa8c16;
  padding: 16rpx;
  background: #fff7e6;
  border-radius: 12rpx;
  margin: 16rpx 0;
}

/* 猜词输入 */
.guess-input {
  margin: 24rpx 0;
}

.guess-field {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  text-align: center;
  box-sizing: border-box;
}

.guess-field:focus {
  border-color: #111217;
}

/* 操作按钮 */
.action-btns {
  display: flex;
  gap: 16rpx;
  justify-content: center;
  margin-top: 24rpx;
}

/* 揭晓阶段 */
.answer-word {
  text-align: center;
  font-size: 56rpx;
  font-weight: 800;
  padding: 30rpx 0;
  animation: fadeInUp 0.4s ease-out;
}

.answer-word.correct {
  color: #52c41a;
}

.answer-word.incorrect {
  color: #ff4d4f;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.your-guess {
  text-align: center;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.text-success {
  color: #52c41a;
  font-weight: 600;
}

.text-danger {
  color: #ff4d4f;
  font-weight: 600;
}

/* 完整例句播放 */
.play-full-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx 0;
}

.audio-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #e6f7ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.audio-btn.playing {
  animation: pulse 1s infinite;
  background: #bae7ff;
}

.play-full-label {
  font-size: 26rpx;
  color: #1890ff;
}

.full-example {
  text-align: center;
  font-size: 30rpx;
  color: #333;
  padding: 20rpx;
  line-height: 1.6;
  background: #f0f9ff;
  border-radius: 12rpx;
  margin: 16rpx 0;
}

/* 结果按钮 */
.result-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.result-btns .btn {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
}
